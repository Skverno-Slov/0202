<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://nlog-project.org"
      xmlns:xsi="http://w3.org">

    <targets>
        <target xsi:type="File" 
                name="errorFile" 
                fileName="${basedir}/logs/errors.log"/>
		<target xsi:type="File"
				name="crashFile"
			    fileName="${basedir}/logs/crash.log"/>
    </targets>
    <rules>
        <logger name="*" level="Error" writeTo="errorFile" />
		<logger name="*" level="Fatal" writeTo="crashFile" />
    </rules>
</nlog>