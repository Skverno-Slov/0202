<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://nlog-project.org"
      xmlns:xsi="http://w3.org">

    <targets>
        <target xsi:type="File" 
                name="errorFile" 
                fileName="${basedir}/logs/errors.log"/>
    </targets>
    <rules>
        <logger name="*" minlevel="Error" writeTo="errorFile" />
    </rules>
</nlog>