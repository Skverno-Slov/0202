<Window x:Class="LabWork1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork1"
        mc:Ignorable="d"
        Title="MainWindow" Height="400
        " Width="200">
    <Grid>
        <TextBox HorizontalAlignment="Center" Margin="0,120,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" x:Name="login_textbox" TextChanged="login_textbox_TextChanged"/>
        <TextBox HorizontalAlignment="Center" Margin="0,199,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" x:Name="password_textbox" TextChanged="password_textbox_TextChanged"/>
        <Button Content="login" HorizontalAlignment="Center" Margin="0,280,0,0" VerticalAlignment="Top" Width="120" x:Name="login_button" Click="login_button_Click"/>
        <Button Content="register" HorizontalAlignment="Center" Margin="0,305,0,0" VerticalAlignment="Top" Width="120" x:Name="reg_button" Click="reg_button_Click"/>
    </Grid>
</Window>
