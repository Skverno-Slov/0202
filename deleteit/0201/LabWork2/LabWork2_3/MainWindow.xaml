<Window x:Class="LabWork2_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork2_3"
        mc:Ignorable="d"
        Title="Регистрация" Height="450" Width="800">
    <StackPanel>
        <TextBlock>Логин</TextBlock>
        <TextBox Name="LoginTextBox"/>
        <TextBlock>Пароль</TextBlock>
        <PasswordBox Name="PasswordBox"/>
        <TextBlock>Подтвердите пароль</TextBlock>
        <PasswordBox Name="ConfirmPasswordBox"/>
        <TextBlock>Электронная почта</TextBlock>
        <TextBox Name="EmailTextBox"/>
        <Button Name="RegistretionButton" Content="Зарегистрироватся" Click="RegistrtionButton_Click"/>
    </StackPanel>
</Window>
